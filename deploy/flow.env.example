# Flow's production settings. Copy to .env next to compose.yaml, fill in, chmod 0600 (it holds secrets):
#   install -m 0600 deploy/flow.env.example .env
# Compose reads it for compose.yaml's ${...} and hands every line to the container. Compose's env-file rules apply:
# in an unquoted value $NAME and ${NAME} are replaced (an unset one by nothing) and " #" starts a comment, so a value
# holding $ or " #" (a generated secret, say) goes in single quotes, taken literally: KEY='a$b #c'. Commented lines
# show the default. docs/deploy.md has the sequence, docs/auth.md the sign-in, docs/architecture.md ("Sandbox
# network") the network and limits.

# --- Compose (read by compose.yaml only) ---
# The proxy network Traefik reaches Flow on (external; Traefik's own).
# PROXY_NETWORK=traefik
# host-setup.sh's Docker network for the sandboxes (its DOCKER_NETWORK).
# DOCKER_NETWORK=flow
# Flow's static address on it, the only container host-setup.sh lets reach the Incus API (its CONTAINER_ADDRESS).
# CONTAINER_ADDRESS=172.30.1.2
# host-setup.sh's CERT_DIR: client.crt, client.key, server.crt, owned by 65532, mounted read-only.
# INCUS_CERT_DIR=/etc/flow-host/incus

# --- Sign-in (docs/auth.md) ---
# BACKEND_AUTH_MODE=oidc
# Host name Flow is served at: Traefik's router rule, the redirect URI https://<it>/api/auth/callback and the only
# origin state changes are accepted from. Bare name: no scheme, port, path or trailing dot.
BACKEND_PUBLIC_FQDN=flow.example.com
# Flow reads <issuer>/.well-known/openid-configuration at start (from inside the container) and does not boot
# without it.
BACKEND_OIDC_ISSUER=https://auth.example.com
BACKEND_OIDC_CLIENT_ID=flow
BACKEND_OIDC_CLIENT_SECRET=
# The owner: a subject, a group, or both (at least one). Groups must be in the ID token.
BACKEND_OIDC_ALLOWED_SUBJECT=
BACKEND_OIDC_ALLOWED_GROUP=
# Signs the session cookie, at least 32 characters: openssl rand -hex 32. Rotating it signs the owner out.
BACKEND_SESSION_SECRET=
# BACKEND_SESSION_TTL=12h

# --- Secrets at rest ---
# AES-256 key sealing stored credentials and flowd tokens: openssl rand -base64 32. Made once and kept: a new key
# makes every stored secret unreadable.
BACKEND_SEAL_KEY=

# --- Incus (host-setup.sh) ---
# The API at host-setup's INCUS_LISTEN, by default the sandbox network's gateway (BACKEND_SANDBOX_GATEWAY).
BACKEND_INCUS_URL=https://172.30.0.1:8443
# BACKEND_INCUS_PROJECT=flow
# BACKEND_INCUS_POOL=default
# Set by compose.yaml (environment wins over this file), to the files in the mounted INCUS_CERT_DIR:
# BACKEND_INCUS_CERT: /etc/flow/incus/client.crt
# BACKEND_INCUS_KEY: /etc/flow/incus/client.key
# BACKEND_INCUS_SERVER_CERT: /etc/flow/incus/server.crt
# Base image alias (deploy/sandbox-image.sh) and the home volume mounted into every sandbox.
# BACKEND_SANDBOX_IMAGE=flow-base
# BACKEND_HOME_VOLUME=flow-home

# --- Sandbox network: exactly what host-setup.sh made (it reads the same names) ---
# BACKEND_SANDBOX_BRIDGE=flowbr0
# BACKEND_SANDBOX_SUBNET=172.30.0.0/16
# BACKEND_SANDBOX_RANGE=172.30.128.0/17
# Default: the subnet's first address.
# BACKEND_SANDBOX_GATEWAY=172.30.0.1
# Public resolvers, or ones on the sandbox subnet; never the host or a private network.
# BACKEND_SANDBOX_RESOLVERS=1.1.1.1,9.9.9.9

# --- Limits ---
# Per sandbox (0: none / all of the host's).
# BACKEND_SANDBOX_MEMORY_MIB=6144
# BACKEND_SANDBOX_CPUS=4
# Memory for all running sandboxes together (0: no check): a sandbox starts while the running ones' measured memory
# plus the headroom fits under it. Headroom default: one sandbox's limit.
# BACKEND_SANDBOX_MEMORY_TOTAL_MIB=14336
# BACKEND_SANDBOX_MEMORY_HEADROOM_MIB=6144
# Per session (agent and everything it runs). Defaults: the sandbox's memory less 1 GiB, its CPUs less one × 100.
# BACKEND_SESSION_MEMORY_MIB=5120
# BACKEND_SESSION_CPU_PERCENT=300
# BACKEND_SESSION_TASKS_MAX=4096

# --- Operation ---
# 1: sessions play a recorded demo turn instead of running an agent (no Claude credential needed).
# BACKEND_SESSION_REPLAY=0
# debug, info, warn, error
# BACKEND_LOG_LEVEL=info

# --- Set by compose.yaml or the image; listed for completeness ---
# BACKEND_ADDR: :8080 (compose.yaml)
# BACKEND_DB_PATH: /data/flow.db (compose.yaml, on the ./data mount)
# Where the image keeps flowd-linux-amd64/-arm64 and the sidecar bundle Flow pushes into sandboxes.
# BACKEND_FLOWD_DIR=/opt/flow
# BACKEND_SIDECAR_DIR=/opt/flow/sidecar
