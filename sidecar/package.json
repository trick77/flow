{
  "name": "flow-sidecar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json && eslint . --max-warnings 0 && npm run format:check",
    "format": "prettier --write 'src/**/*.ts' '*.js'",
    "format:check": "prettier --check 'src/**/*.ts' '*.js'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.332"
  }
}
